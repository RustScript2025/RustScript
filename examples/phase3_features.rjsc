// Phase 3 Features Demo: Safety & Contracts
// Author: Michael Lauzon
// This file demonstrates all Phase 3 features of RustScript

// ============================================================================
// Feature 1: Design by Contract
// ============================================================================

// Preconditions with requires
fn divide(a: number, b: number) -> number
    requires b != 0, "Divisor cannot be zero"
    ensures result * b ≈ a, "Result must satisfy a/b * b ≈ a"
{
    a / b
}

// Multiple preconditions
fn sqrt(x: number) -> number
    requires x >= 0, "Cannot take square root of negative number"
    ensures result * result ≈ x, "Result squared must equal input"
    ensures result >= 0, "Result must be non-negative"
{
    Math.sqrt(x)
}

// Invariants for data structures
struct BankAccount {
    balance: number,
    account_number: string,
}

fn withdraw(account: BankAccount, amount: number) -> BankAccount
    requires amount > 0, "Withdrawal amount must be positive"
    requires account.balance >= amount, "Insufficient funds"
    ensures result.balance == account.balance - amount
    invariant result.balance >= 0, "Balance must never be negative"
{
    BankAccount {
        balance: account.balance - amount,
        account_number: account.account_number,
    }
}

fn deposit(account: BankAccount, amount: number) -> BankAccount
    requires amount > 0, "Deposit amount must be positive"
    ensures result.balance == account.balance + amount
    invariant result.balance >= 0
{
    BankAccount {
        balance: account.balance + amount,
        account_number: account.account_number,
    }
}

// Contract with complex conditions
fn binary_search(arr: [number], target: number) -> number
    requires arr.is_sorted(), "Array must be sorted"
    ensures result >= -1 && result < arr.length
    ensures result == -1 || arr[result] == target
{
    let (left, right) = (0, arr.length - 1);
    
    while left <= right {
        let mid = (left + right) / 2;
        
        if arr[mid] == target {
            return mid;
        } else if arr[mid] < target {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }
    
    -1
}

fn demo_contracts() {
    console.log("=== Design by Contract Demo ===");
    
    // Valid operations
    let result = divide(10.0, 2.0);
    console.log("10 / 2 = {result}");
    
    let root = sqrt(16.0);
    console.log("sqrt(16) = {root}");
    
    // Bank account operations
    let account = BankAccount {
        balance: 1000.0,
        account_number: "12345",
    };
    
    let account = deposit(account, 500.0);
    console.log("After deposit: {account.balance}");
    
    let account = withdraw(account, 200.0);
    console.log("After withdrawal: {account.balance}");
    
    // These would fail at runtime:
    // divide(10.0, 0.0);  // Contract violation: divisor cannot be zero
    // sqrt(-1.0);         // Contract violation: negative input
    // withdraw(account, 2000.0);  // Contract violation: insufficient funds
}

// ============================================================================
// Feature 2: Effect System
// ============================================================================

// Pure function (no side effects)
effect [pure]
fn add(a: number, b: number) -> number {
    a + b
}

// Function with I/O effects
effect [io]
fn read_file(path: string) -> string {
    // Reads from file system
    ""
}

// Function with state effects
effect [state]
fn increment_counter(counter: number) -> number {
    counter + 1
}

// Function that may throw
effect [throws]
fn parse_number(s: string) -> number {
    // May throw if string is not a valid number
    s.parse()
}

// Function with multiple effects
effect [io, throws]
fn load_config(path: string) -> Config {
    let content = read_file(path);  // IO effect
    parse_config(content)            // Throws effect
}

// Function with allocation
effect [alloc]
fn create_buffer(size: number) -> [number] {
    let buffer = [];
    for i in 0..size {
        buffer.push(0);
    }
    buffer
}

// Read and write effects
effect [read]
fn get_user_input() -> string {
    // Reads from stdin
    ""
}

effect [write]
fn print_output(message: string) {
    console.log(message);
}

// Effect composition
effect [io, state, throws]
fn process_transaction(account: BankAccount, amount: number) -> BankAccount {
    // IO: Log transaction
    console.log("Processing transaction: {amount}");
    
    // State: Modify account
    let new_account = withdraw(account, amount);
    
    // Throws: May fail if insufficient funds
    if new_account.balance < 0 {
        throw "Transaction failed";
    }
    
    new_account
}

fn demo_effects() {
    console.log("=== Effect System Demo ===");
    
    // Pure functions can be called anywhere
    let sum = add(5, 3);
    console.log("Pure addition: {sum}");
    
    // Effects are tracked by the compiler
    let buffer = create_buffer(10);  // Alloc effect
    console.log("Buffer created with {buffer.length} elements");
    
    // Effect propagation
    // Functions calling effectful functions inherit those effects
    effect [io, throws]
    fn load_and_process() {
        let config = load_config("config.json");  // IO + Throws
        console.log("Config loaded");
    }
}

// Effect polymorphism
effect [E]
fn map<T, U, E>(items: [T], f: fn(T) -> U effect [E]) -> [U] effect [E] {
    let result = [];
    for item in items {
        result.push(f(item));
    }
    result
}

// ============================================================================
// Feature 3: Compile-time Execution
// ============================================================================

// Compile-time constants
comptime {
    const BUFFER_SIZE = 1024;
    const MAX_USERS = 100;
    const VERSION = "1.0.0";
}

// Compile-time function execution
comptime {
    fn fibonacci_at_compile_time(n: number) -> number {
        if n <= 1 {
            n
        } else {
            fibonacci_at_compile_time(n - 1) + fibonacci_at_compile_time(n - 2)
        }
    }
    
    const FIB_10 = fibonacci_at_compile_time(10);
}

// Compile-time code generation
comptime {
    fn generate_accessor(field_name: string) -> string {
        "fn get_{field_name}(obj: Object) -> any { obj.{field_name} }"
    }
    
    // Generate getters at compile time
    const GET_NAME = generate_accessor("name");
    const GET_AGE = generate_accessor("age");
}

// Compile-time type checking
comptime {
    fn assert_type<T>(value: T, expected_type: string) {
        if typeof(value) != expected_type {
            compile_error("Type mismatch: expected {expected_type}");
        }
    }
}

// Compile-time configuration
comptime {
    const DEBUG = true;
    const OPTIMIZATION_LEVEL = 2;
    
    if DEBUG {
        fn log_debug(message: string) {
            console.log("[DEBUG] {message}");
        }
    } else {
        fn log_debug(message: string) {
            // No-op in release mode
        }
    }
}

// Compile-time array generation
comptime {
    fn generate_lookup_table(size: number) -> [number] {
        let table = [];
        for i in 0..size {
            table.push(i * i);
        }
        table
    }
    
    const SQUARES = generate_lookup_table(100);
}

fn demo_comptime() {
    console.log("=== Compile-time Execution Demo ===");
    
    // Use compile-time constants
    console.log("Buffer size: {BUFFER_SIZE}");
    console.log("Max users: {MAX_USERS}");
    console.log("Version: {VERSION}");
    
    // Use compile-time computed values
    console.log("Fibonacci(10) computed at compile time: {FIB_10}");
    
    // Use compile-time generated lookup table
    console.log("Square of 7 (from compile-time table): {SQUARES[7]}");
    
    // Compile-time conditional compilation
    log_debug("This message only appears in debug builds");
}

// Compile-time metaprogramming
comptime {
    fn generate_struct_methods(struct_name: string, fields: [string]) {
        for field in fields {
            // Generate getter
            eval("
                fn get_{field}(obj: {struct_name}) -> any {
                    obj.{field}
                }
            ");
            
            // Generate setter
            eval("
                fn set_{field}(obj: {struct_name}, value: any) -> {struct_name} {
                    obj.{field} = value;
                    obj
                }
            ");
        }
    }
    
    // Generate methods for User struct
    generate_struct_methods("User", ["name", "email", "age"]);
}

// ============================================================================
// Combined Example: All Features Together
// ============================================================================

// Compile-time configuration
comptime {
    const MAX_RETRIES = 3;
    const TIMEOUT_MS = 5000;
}

// Effect-tracked function with contracts
effect [io, throws]
fn fetch_data(url: string) -> string
    requires url.length > 0, "URL cannot be empty"
    requires url.starts_with("http"), "URL must be HTTP/HTTPS"
    ensures result.length > 0, "Response cannot be empty"
{
    // Simulated HTTP request
    console.log("Fetching: {url}");
    "{ \"status\": \"ok\" }"
}

// Pure function with contracts
effect [pure]
fn validate_response(response: string) -> bool
    requires response.length > 0
    ensures result == true || result == false
{
    response.contains("status")
}

// Stateful function with contracts and effects
effect [io, state, throws]
fn retry_fetch(url: string, retries: number) -> string
    requires retries > 0 && retries <= MAX_RETRIES
    ensures result.length > 0
{
    let attempts = 0;
    
    while attempts < retries {
        comptime {
            if DEBUG {
                console.log("Attempt {attempts + 1} of {retries}");
            }
        }
        
        let response = fetch_data(url);
        
        if validate_response(response) {
            return response;
        }
        
        attempts += 1;
    }
    
    throw "Failed after {retries} attempts";
}

// Data structure with invariants
struct Cache {
    data: [string],
    max_size: number,
}

effect [state, alloc]
fn cache_add(cache: Cache, item: string) -> Cache
    requires item.length > 0
    invariant cache.data.length <= cache.max_size
    ensures result.data.length <= result.max_size
{
    if cache.data.length >= cache.max_size {
        // Remove oldest item
        cache.data.shift();
    }
    
    cache.data.push(item);
    cache
}

fn demo_combined() {
    console.log("=== Combined Features Demo ===");
    
    // Compile-time configuration affects runtime behaviour
    console.log("Max retries: {MAX_RETRIES}");
    console.log("Timeout: {TIMEOUT_MS}ms");
    
    // Effect-tracked function with contracts
    let response = retry_fetch("https://api.example.com/data", MAX_RETRIES);
    console.log("Response: {response}");
    
    // Data structure with invariants
    let cache = Cache {
        data: [],
        max_size: 5,
    };
    
    cache = cache_add(cache, "item1");
    cache = cache_add(cache, "item2");
    console.log("Cache size: {cache.data.length}");
}

// ============================================================================
// Real-World Example: Safe Database Operations
// ============================================================================

struct Database {
    connection_string: string,
    connected: bool,
}

effect [io, throws]
fn connect(db: Database) -> Database
    requires db.connection_string.length > 0
    ensures result.connected == true
{
    console.log("Connecting to database...");
    Database {
        connection_string: db.connection_string,
        connected: true,
    }
}

effect [io, state, throws]
fn execute_query(db: Database, query: string) -> [any]
    requires db.connected, "Database must be connected"
    requires query.length > 0, "Query cannot be empty"
    ensures result.length >= 0
{
    console.log("Executing: {query}");
    []
}

effect [io]
fn disconnect(db: Database) -> Database
    requires db.connected
    ensures result.connected == false
{
    console.log("Disconnecting from database...");
    Database {
        connection_string: db.connection_string,
        connected: false,
    }
}

// Compile-time query validation
comptime {
    fn validate_sql(query: string) -> bool {
        // Simple validation at compile time
        let dangerous_keywords = ["DROP", "DELETE", "TRUNCATE"];
        for keyword in dangerous_keywords {
            if query.uppercase().contains(keyword) {
                return false;
            }
        }
        true
    }
}

effect [io, state, throws]
fn safe_database_operation() {
    let db = Database {
        connection_string: "postgresql://localhost/mydb",
        connected: false,
    };
    
    // Connect with contract checking
    db = connect(db);
    
    // Compile-time validated query
    comptime {
        const QUERY = "SELECT * FROM users WHERE active = true";
        if !validate_sql(QUERY) {
            compile_error("Dangerous SQL query detected");
        }
    }
    
    // Execute with effect tracking
    let results = execute_query(db, QUERY);
    console.log("Found {results.length} results");
    
    // Ensure cleanup with defer
    defer {
        db = disconnect(db);
    }
}

// ============================================================================
// Main Entry Point
// ============================================================================

fn main() {
    console.log("=== Phase 3 Features Demo ===");
    console.log("");
    
    console.log("1. Design by Contract:");
    demo_contracts();
    console.log("");
    
    console.log("2. Effect System:");
    demo_effects();
    console.log("");
    
    console.log("3. Compile-time Execution:");
    demo_comptime();
    console.log("");
    
    console.log("4. Combined Features:");
    demo_combined();
    console.log("");
    
    console.log("5. Real-World Example:");
    safe_database_operation();
    console.log("");
    
    console.log("=== Demo Complete ===");
}
