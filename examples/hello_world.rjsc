// ============================================================================
// Hello, World! - Your First RustScript Programme
// ============================================================================
// Author: Michael Lauzon
// 
// This is the traditional first programme in any language.
// It demonstrates the basic structure of a RustScript programme.
//
// In RustScript, the main() function serves as the entry point,
// similar to Rust, C, and many other languages.
// ============================================================================

// The main function - entry point of the programme.
fn main() {
    console.log("Hello, World!");
}

// Call the main function to run the programme.
main();
