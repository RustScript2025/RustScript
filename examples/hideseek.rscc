// ============================================================================
// Hide and Seek Adventure Game
// ============================================================================
// Converted from BASIC to RustScript.
// RustScript's first game!
//
// This game demonstrates RustScript's capabilities including:
//   - Structs for data organisation
//   - Pattern matching for game logic
//   - String interpolation for dynamic output
//   - Mutable state management
//
// Author: Michael Lauzon
// Licence: MIT
// ============================================================================

// ============================================================================
// Game Data Structures
// ============================================================================

// Represents a room in the house with navigation links to adjacent rooms.
// A value of 0 indicates no exit in that direction.
struct Room {
    name: string,
    description: string,
    north: number,
    south: number,
    east: number,
    west: number,
}

// Represents a potential hiding spot within a room.
// Each spot tracks whether someone is hiding there and if it has been searched.
struct HidingSpot {
    name: string,
    room_id: number,
    has_person: bool,
    found: bool,
}

// Tracks the current state of the game including player progress and scoring.
// Scoring values are configurable based on difficulty level.
struct GameState {
    player_name: string,
    current_room: number,
    score: number,
    turns_left: number,
    total_hidden: number,
    hints_used: number,
    free_hints: number,
    hint_cost: number,
    find_reward: number,
    miss_penalty: number,
}

// ============================================================================
// Room Setup
// ============================================================================

// Creates and returns an array of all rooms in the house.
// Room indices are 1-based for easier reference in the game.
// Navigation values reference other room indices (0 = no exit).
fn create_rooms() -> [Room] {
    [
        Room { name: "Living Room", description: "A cosy living room with a fireplace and comfortable furniture.", north: 10, south: 0, east: 2, west: 0 },
        Room { name: "Kitchen", description: "A modern kitchen with stainless steel appliances.", north: 0, south: 8, east: 11, west: 1 },
        Room { name: "Bedroom", description: "A bedroom with a large bed and wooden furniture.", north: 0, south: 10, east: 4, west: 12 },
        Room { name: "Bathroom", description: "A clean bathroom with white tiles.", north: 0, south: 0, east: 0, west: 3 },
        Room { name: "Basement", description: "A dark basement filled with old boxes and equipment.", north: 10, south: 0, east: 0, west: 0 },
        Room { name: "Attic", description: "A dusty attic with old furniture and memorabilia.", north: 0, south: 10, east: 0, west: 0 },
        Room { name: "Garage", description: "A garage with tools and a car.", north: 0, south: 0, east: 10, west: 0 },
        Room { name: "Garden", description: "A beautiful garden with flowers and trees.", north: 2, south: 0, east: 0, west: 0 },
        Room { name: "Study", description: "A quiet study lined with bookshelves.", north: 0, south: 0, east: 0, west: 10 },
        Room { name: "Hallway", description: "A long hallway connecting various rooms.", north: 3, south: 1, east: 9, west: 7 },
        Room { name: "Dining Room", description: "An elegant dining room with a large table.", north: 0, south: 0, east: 0, west: 2 },
        Room { name: "Closet", description: "A small closet filled with clothes and storage.", north: 0, south: 0, east: 3, west: 0 },
    ]
}

// ============================================================================
// Hiding Spots Setup
// ============================================================================

